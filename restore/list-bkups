#!/bin/bash

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
APP_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)

REPO="/mnt/media/backup/sys-bkup/sys-bkup-restic"
PASSWORD_FILE="$APP_DIR/restic-cred.txt"

restic -r "$REPO" --password-file "$PASSWORD_FILE" snapshots --json --tag sys \
  | python3 -c '
import json, sys, re
from datetime import datetime

rows = []
for snap in json.load(sys.stdin):
    raw = snap.get("time", "")
    if not raw:
        continue
    clean = re.sub(r"\.\d+", "", raw)
    when = datetime.fromisoformat(clean)
    rows.append((when.timestamp(), when.strftime("%Y/%m/%d %H:%M:%S"), snap.get("short_id", "")))

rows.sort(key=lambda item: item[0], reverse=True)
for _epoch, stamp, short_id in rows:
    print(f"{stamp} {short_id}".rstrip())
'