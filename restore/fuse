#!/bin/bash

#
# Convenience wrapper for `./add-folders`.
#
# How to run: `./fuse [snapshot_specifier]`
#
# Details: This script passes all of its arguments directly to `./add-folders`.

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
exec "$SCRIPT_DIR/add-folders" "$@"