#!/bin/bash
#
# Mounts a `restic` backup repository as a FUSE filesystem. This allows you to
# browse the backup snapshots as if they were regular directories.
#
# The script mounts the repository located at `/mnt/media/backup/mlap` onto the
# `/mnt/mlap-bkup` directory. It requires `restic` to be installed and a
# password file at /root/dev/apps/mlap-bkup/.restic. If the mount point is already
# active, it will be unmounted first.

REPO="/mnt/media/backup/mlap"
MOUNTPOINT="/mnt/mlap-bkup"
PASSWORD_FILE="/root/dev/apps/mlap-bkup/.restic"

cleanup_mount() {
  local path="$1"

  if findmnt -rn "$path" >/dev/null 2>&1; then
    echo "Unmounting $path ..."
    fusermount -uz "$path" 2>/dev/null || umount -l "$path" 2>/dev/null || umount "$path" 2>/dev/null || true
  fi

  if [[ -e "$path" || -L "$path" ]] && ! stat "$path" >/dev/null 2>&1; then
    rm -rf "$path"
  fi
}

cleanup_mount /mnt/mlap-mark
cleanup_mount /mnt/mlap-root
cleanup_mount "$MOUNTPOINT"

mkdir -p "$MOUNTPOINT"

echo "Mounting $REPO at $MOUNTPOINT ..."
restic -r "$REPO" -p "$PASSWORD_FILE" mount --allow-other "$MOUNTPOINT"
