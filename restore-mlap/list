#!/bin/bash

#
# Lists available snapshots in the mlap `restic` repository.
#
# How to run:
#   ./list        # Lists the 10 most recent snapshots
#   ./list 20     # Lists the 20 most recent snapshots
#
# Details: The script reads snapshots from
# `/mnt/media/backup/mlap`, filters to the `sys` tag, and
# prints restore points newest-first as `YYYY/MM/DD HH:MM:SS short_id`.

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
APP_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)

REPO="/mnt/media/backup/mlap"
PASSWORD_FILE="$APP_DIR/restic-cred.txt"
LIMIT="${1:-10}"

restic -r "$REPO" --password-file "$PASSWORD_FILE" snapshots --json --tag automated \
  | python3 -c "
import json, sys, re
from datetime import datetime

limit = int('$LIMIT')

rows = []
for snap in json.load(sys.stdin):
    raw = snap.get('time', '')
    if not raw:
        continue
    clean = re.sub(r'\.\d+', '', raw)
    when = datetime.fromisoformat(clean)
    rows.append((when.timestamp(), when.strftime('%Y/%m/%d %H:%M:%S'), snap.get('short_id', '')))

rows.sort(key=lambda item: item[0], reverse=True)
for _epoch, stamp, short_id in rows[:limit]:
    print(f'{stamp} {short_id}'.rstrip())
"